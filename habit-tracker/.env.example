# --- База ---
DATABASE_URL="file:./dev.db"

# --- Passcode-защита (раздел 2 ТЗ) ---
# Код доступа к приложению. Обязателен: без него middleware не пустит внутрь.
APP_PASSCODE="0000"
# Секрет для подписи cookie сессии. Сгенерировать: openssl rand -hex 32
SESSION_SECRET="change-me-openssl-rand-hex-32"

# --- Часовой пояс ---
# Все "дни" (стрики, недельные сбросы, тепловая карта) считаются в этой зоне,
# а не в UTC и не в зоне сервера.
APP_TIMEZONE="Europe/Moscow"

# --- Web Push (вечернее напоминание) ---
# Сгенерировать пару: npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:me@example.com"
# Секрет для защиты POST /api/push/send (дёргается внешним планировщиком/cron хостинга)
PUSH_CRON_SECRET="change-me"
