{
  "name": "habit-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:studio": "prisma studio",
    "gen:vapid": "tsx scripts/generate-vapid.ts",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "test:domain": "DATABASE_URL=\"file:./test.db\" prisma db push --skip-generate --force-reset --accept-data-loss && DATABASE_URL=\"file:./test.db\" tsx scripts/domain-check.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/web-push": "3.6.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
